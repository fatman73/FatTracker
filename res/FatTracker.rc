#include <winuser.h>
#include <winver.h>

1 RT_MANIFEST "app.manifest"
1 ICON "icon.ico"

// File properties in Explorer; the full credits are in CREDITS.txt and in HELP: CREDITS.
VS_VERSION_INFO VERSIONINFO
FILEVERSION 0,1,0,0
PRODUCTVERSION 0,1,0,0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "fatman73"
            VALUE "FileDescription", "FatTracker"
            VALUE "FileVersion", "0.1"
            VALUE "InternalName", "FatTracker"
            VALUE "LegalCopyright", "Copyright (C) 2026 fatman73 - GNU GPL v2+"
            VALUE "OriginalFilename", "FatTracker.exe"
            VALUE "ProductName", "FatTracker"
            VALUE "ProductVersion", "0.1"
            VALUE "Comments", "Free software under the GNU GPL v2 or later, WITHOUT ANY WARRANTY. https://github.com/fatman73/FatTracker"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
